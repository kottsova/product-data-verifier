# Copy to .env and fill in real values locally. .env itself is git-ignored --
# never commit real secrets. This project does not load .env automatically
# (no python-dotenv dependency); export these as real environment variables,
# e.g. `set -a && source .env && set +a` (bash) before running the bot.

# Required only for `python -m bot.telegram_bot`. python app.py does not need it.
TELEGRAM_BOT_TOKEN=123456:REPLACE_WITH_YOUR_BOT_TOKEN

# Optional -- see README for defaults and validation rules.
PRODUCT_VERIFIER_DB_PATH=./.cache/product_verifier.sqlite3
PRODUCT_VERIFIER_MAX_CONCURRENT_JOBS=2
PRODUCT_VERIFIER_JOB_HISTORY_LIMIT=20
PRODUCT_VERIFIER_CACHE_TTL_SECONDS=3600

# Stage 25/30: cross-process discovery provider health (circuit breaker) --
# a writable file path. Unset means the breaker is disabled (Stage 25/29
# default). core/provider_health.py reads this directly, not config.py --
# see tests/test_config.py's EnvironmentReadingBoundaryTests for why.
PDV_PROVIDER_HEALTH_PATH=./.cache/provider_health.json

# Stage 30: comma-separated discovery provider names to disable outright.
# duckduckgo_lite is disabled by default in the MVP production profile --
# Stage 29's blind benchmark showed it contributes 0 accepted evidence while
# still consuming full retrieval budget. core/discovery.py reads this
# directly, not config.py -- see the note above.
PDV_DISABLED_DISCOVERY_PROVIDERS=duckduckgo_lite
